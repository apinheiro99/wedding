# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
EVENT_TITLE="O nosso dia"

# PostgreSQL bootstrap (needs CREATE DATABASE permission)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_MAINTENANCE_DB=postgres
PG_APP_DB=wedding_photos

STORAGE_ROOT=./storage
SESSION_SECRET=change-me-at-least-32-chars-long-random
FAMILY_BOOTSTRAP_LOGIN=familia
FAMILY_BOOTSTRAP_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# email: "dev" (writes to storage/temp/mail, visible at /dev/mail) or "resend"
EMAIL_PROVIDER=dev
EMAIL_FROM="Fotos <fotos@example.com>"
RESEND_API_KEY=
# Daily report recipient (deliverable address). Defaults to ADMIN_EMAIL, which is skipped if it ends in .local
# REPORT_EMAIL=you@example.com

PACKAGE_TARGET_BYTES=2147483648
UPLOAD_CHUNK_BYTES=8388608
DIGEST_QUIET_MINUTES=15
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Logging (all optional). Levels: trace < debug < info < warn < error < fatal
# Level and retention can also be changed at runtime in Admin -> Settings -> Logs.
# LOG_LEVEL=debug          # default: debug in development, info in production
# LOG_FORMAT=pretty        # pretty | json (default: pretty in dev, json in prod)
# LOG_DIR=./logs           # daily files app-YYYY-MM-DD.log / error-YYYY-MM-DD.log; empty disables files
# LOG_RETAIN_DAYS=7        # days of log files to keep
# LOG_DEBUG=upload,worker  # force debug for specific scopes only

# Largest single file accepted (bytes, default 10 GiB)
# MAX_UPLOAD_BYTES=10737418240
