# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
EVENT_TITLE="Nosso Casamento"

# PostgreSQL bootstrap (needs CREATE DATABASE permission)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_MAINTENANCE_DB=postgres
PG_APP_DB=wedding_photos

STORAGE_ROOT=./storage
SESSION_SECRET=change-me-at-least-32-chars-long-random
FAMILY_BOOTSTRAP_LOGIN=familia
FAMILY_BOOTSTRAP_PASSWORD=
ADMIN_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=

# email: "dev" (writes to storage/temp/mail, visible at /dev/mail) or "resend"
EMAIL_PROVIDER=dev
EMAIL_FROM="Fotos <fotos@example.com>"
RESEND_API_KEY=

PACKAGE_TARGET_BYTES=2147483648
UPLOAD_CHUNK_BYTES=8388608
DIGEST_QUIET_MINUTES=15
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
